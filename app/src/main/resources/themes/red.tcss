#title {
    color: #baacb8;
}

#sidebar {
    border-type: rounded;
    border-color: #8d3441;
    color: #baacb8;
}

#sidebar ListElement-item:selected {  
    color: #ef586f;
    text-style: bold;
}

#suggestions {
    border-type: rounded;
    border-color: #8d3441;
    color: #baacb8;
}

#suggestions ListElement-item:selected {
    color: #ef586f;
    text-style: bold;
}

#searchbar {
    border-type: rounded;
    border-color: #8d3441;
    color: #baacb8;
}

.slashcommand-name {
    text-style: bold;
}
.slashcommand-desc {
    text-style: dim;
}